# Copy to ignored .local/workflow-b/backend.env; use only B resources.
NODE_ENV=development
WORKFLOW_PROTOCOL=ADVANCE
PORT=3001
WEB_ORIGIN=http://localhost:5174
AUTH_DOMAIN=localhost:5174
AUTH_CHAIN_ID=31338
CHAIN_ID=31338
AUTH_SESSION_COOKIE_NAME=ft_workflow_b_session
DATABASE_URL=postgresql://postgres:LOCAL_B_PASSWORD@localhost:5434/fundtogether_workflow_b
BLOCKCHAIN_RPC_URL=http://127.0.0.1:9547
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=fundtogether-workflow-b-private
S3_ACCESS_KEY_ID=LOCAL_B_ACCESS_KEY
S3_SECRET_ACCESS_KEY=LOCAL_B_STORAGE_PASSWORD

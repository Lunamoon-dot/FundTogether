# Copy to ignored .local/hed/backend.env; use only HED resources.
NODE_ENV=development
HED_PROTOCOL=HED
PORT=3002
WEB_ORIGIN=http://localhost:5175
AUTH_DOMAIN=localhost:5175
AUTH_CHAIN_ID=31339
CHAIN_ID=31339
AUTH_SESSION_COOKIE_NAME=ft_hed_session
DATABASE_URL=postgresql://postgres:LOCAL_HED_PASSWORD@localhost:5435/fundtogether_hed
HED_BLOCKCHAIN_RPC_URL=http://127.0.0.1:9548
S3_ENDPOINT=http://localhost:9200
S3_REGION=us-east-1
S3_BUCKET=fundtogether-hed-private
S3_ACCESS_KEY_ID=LOCAL_HED_ACCESS_KEY
S3_SECRET_ACCESS_KEY=LOCAL_HED_STORAGE_PASSWORD
HED_INDEXER_ENABLED=true

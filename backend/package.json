{
  "name": "fundtogether-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "artifacts:historical": "node scripts/campaigns/generate-historical-artifacts.cjs",
    "artifacts:campaigns": "node scripts/campaigns/generate-campaign-artifacts.cjs",
    "token:mint": "node scripts/campaigns/mint-mock-usdc.cjs",
    "seed:accounts": "node scripts/campaigns/seed-local-accounts.cjs",
    "test:campaigns": "npm run test -- --runInBand src/blockchain/deployment.spec.ts src/modules/campaigns/tests/commitment.spec.ts src/modules/campaigns/tests/publication.service.spec.ts src/modules/delivery/tests/delivery.policy.spec.ts src/modules/campaigns/tests/http.spec.ts src/modules/review/tests/review-http.spec.ts src/indexer/tests/campaign-indexer.integration.spec.ts src/modules/delivery/tests/pdf.spec.ts src/modules/delivery/tests/delivery-http.spec.ts",
    "start:fundtogether": "node scripts/campaigns/run-backend.cjs",
    "start:vnext": "node scripts/campaigns/run-vnext-backend.cjs",
    "db:fundtogether:migrate": "node scripts/campaigns/migrate-isolated.cjs",
    "vnext:verify-runtime": "node scripts/campaigns/verify-vnext-runtime.cjs",
    "test:vnext-acceptance": "node scripts/campaigns/vnext-scenarios-e2e.cjs",
    "test:vnext-browser": "node scripts/campaigns/vnext-browser-e2e.cjs",
    "test:vnext-runtime": "node --test scripts/campaigns/vnext-runtime-identity.test.cjs",
    "test:vnext:unit": "npm run test -- --runInBand --testMatch \"**/vnext*.spec.ts\" --testPathIgnorePatterns vnext-indexer.postgres.spec.ts",
    "test:workflow": "npm run test -- --runInBand src/modules/campaigns/tests/workflow-campaign.schema.spec.ts src/modules/pledges/tests/workflow-pledge.schema.spec.ts src/modules/campaigns/tests/workflow-commitment.service.spec.ts src/indexer/tests/historical-campaign-indexer.service.spec.ts src/modules/campaigns/tests/commitment.spec.ts",
    "test:fundtogether:e2e": "node scripts/campaigns/campaign-scenarios-e2e.cjs && npm run test -- --runInBand src/modules/campaigns/tests/workflow-http-acceptance.spec.ts src/modules/campaigns/tests/http.spec.ts src/modules/review/tests/review-http.spec.ts",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "latest",
    "@aws-sdk/s3-request-presigner": "latest",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "latest",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "argon2": "latest",
    "bullmq": "latest",
    "class-transformer": "latest",
    "class-validator": "latest",
    "drizzle-orm": "latest",
    "file-type": "latest",
    "ioredis": "latest",
    "nestjs-pino": "latest",
    "pdf-lib": "1.17.1",
    "pg": "latest",
    "pino": "latest",
    "pino-http": "latest",
    "reflect-metadata": "latest",
    "rxjs": "^7.8.0",
    "siwe": "latest",
    "viem": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "latest",
    "@types/supertest": "^6.0.2",
    "dotenv": "latest",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.0.0",
    "ts-loader": "^9.5.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "8.72.1"
  }
}

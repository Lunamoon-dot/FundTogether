{
  "name": "fundtogether-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:workflow-b": "node scripts/workflow-b/migrate-isolated.cjs",
    "db:migrate:hed": "node scripts/hed/migrate-isolated.cjs",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "start:workflow-b": "node scripts/workflow-b/run-backend.cjs",
    "start:hed": "node scripts/hed/run-backend.cjs",
    "api:export:workflow-b": "node scripts/workflow-b/export-openapi.cjs",
    "artifacts:hed": "node scripts/hed/generate-artifacts.cjs",
    "smoke:hed": "node scripts/hed/journey-smoke.cjs",
    "smoke:hed:reorg": "node scripts/hed/reorg-smoke.cjs",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "latest",
    "@aws-sdk/s3-request-presigner": "latest",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "latest",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "argon2": "latest",
    "bullmq": "latest",
    "class-transformer": "latest",
    "class-validator": "latest",
    "drizzle-orm": "latest",
    "file-type": "latest",
    "ioredis": "latest",
    "nestjs-pino": "latest",
    "pg": "latest",
    "pino": "latest",
    "pino-http": "latest",
    "reflect-metadata": "latest",
    "rxjs": "^7.8.0",
    "siwe": "latest",
    "viem": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "latest",
    "@types/supertest": "^6.0.2",
    "dotenv": "latest",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.0.0",
    "ts-loader": "^9.5.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.7.2"
  }
}
